# ── OpenAI（言い換えにだけ使う。未設定でもテンプレ文で動く）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 音声（OPENAI_API_KEY があれば有効。すべて既定値で動く）
# 声：alloy / echo / shimmer / nova / sage / coral など
TTS_VOICE=shimmer
TTS_MODEL=gpt-4o-mini-tts
STT_MODEL=gpt-4o-mini-transcribe

# ── DB（未設定ならモックデータで動く）
# 直接URLを書く場合
DATABASE_URL=
# または分割して指定
DB_HOST=
DB_PORT=5432
DB_NAME=
DATABASE_USER=
DATABASE_PASS=

PORT=3100
