# このアプリが所有する DB (本番は AWS RDS for PostgreSQL)
APP_DATABASE_URL=postgres://app:app@localhost:5432/app
# disable | require | verify-full  (RDS では require 以上を使うこと)
APP_DATABASE_SSL=disable
APP_DATABASE_POOL_MAX=10

# 統計情報用の外部 PostgreSQL (このアプリの管理外・参照専用)
STATS_DATABASE_URL=postgres://stats_reader:stats@localhost:5433/stats
STATS_DATABASE_SSL=disable
STATS_DATABASE_POOL_MAX=5

# 起動時にマイグレーションを流すか。未指定なら production のみ流す
# (pnpm dev でも毎回流したい場合は true)
# APP_DATABASE_MIGRATE_ON_STARTUP=true
